# Copy this file to `.env` and fill in the values:  cp .env.example .env
# `.env` is git-ignored. Never commit real keys.
# EXPO_PUBLIC_* values are bundled into the app, so they must not hold secrets.

# staging | production
EXPO_PUBLIC_APP_ENV=staging

# Main API (WebService.baseURL / villageService)
EXPO_PUBLIC_API_BASE_URL=https://v1-663580528661.asia-south1.run.app

# Village customer-app API (auth, page layouts, category products, orders).
# nginx rejects requests whose User-Agent lacks "Mozilla" (apiClient sets it).
EXPO_PUBLIC_VILLAGE_API_BASE_URL=https://ub7mvw9ks.bizzz.in

# Default store sent as the x-store-id header on every request
EXPO_PUBLIC_DEFAULT_STORE_ID=68989c821388764b3a92f0dd

# Google Maps SDK key (Android + iOS), read in app.config.ts at build time.
# Ask a teammate for the key or create your own restricted to the app's
# bundle id / package name. Leave empty to run without maps.
GOOGLE_MAPS_API_KEY=

# Web build only (env.web.ts): VITE_* overrides, fall back to the EXPO_PUBLIC_* values above.
# VITE_APP_ENV=
# VITE_API_BASE_URL=
# VITE_VILLAGE_API_BASE_URL=

# EAS builds do NOT read this file. Set the same variables as EAS environment
# variables (preview / production) or the built APK ships with empty API URLs.

# Firebase (analytics, crashlytics, FCM). Download from the Firebase console for
# in.villagedelivery.consumer and place in the project root (git-ignored):
#   google-services.json, GoogleService-Info.plist
# On EAS, create file-type env vars GOOGLE_SERVICES_JSON / GOOGLE_SERVICE_INFO_PLIST.
